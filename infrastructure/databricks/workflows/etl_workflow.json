{
  "comment": "Example Databricks Workflow JSON (alternative to databricks.yml DAB). Import via UI or API.",
  "name": "CHANGE_ME-etl-pipeline",
  "job_clusters": [{"job_cluster_key": "etl_cluster", "new_cluster": {
    "spark_version": "15.4.x-scala2.12", "node_type_id": "m5.xlarge",
    "autoscale": {"min_workers": 1, "max_workers": 4}}}],
  "tasks": [
    {"task_key": "silver", "job_cluster_key": "etl_cluster",
     "notebook_task": {"notebook_path": "/Repos/CHANGE_ME/silver/jobs/silver_job"}},
    {"task_key": "gold", "depends_on": [{"task_key": "silver"}], "job_cluster_key": "etl_cluster",
     "notebook_task": {"notebook_path": "/Repos/CHANGE_ME/gold/marts/gold_job"}},
    {"task_key": "consumption", "depends_on": [{"task_key": "gold"}], "job_cluster_key": "etl_cluster",
     "notebook_task": {"notebook_path": "/Repos/CHANGE_ME/consumption/jobs/consumption_job"}}
  ],
  "schedule": {"quartz_cron_expression": "0 0 18 * * ?", "timezone_id": "UTC"}
}
